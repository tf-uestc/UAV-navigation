<launch>
  <arg name="speed_limit" default="0.8"/>
  <arg name="accel_limit" default="0.8"/>
  <arg name="obstacle_inflation" default="0.099"/>
  <arg name="refinement_fitness" default="1.0"/>
  <arg name="with_planner" default="true"/>
  <arg name="mock_fcu" default="false"/>
  <arg name="segment_fence" default="false"/>
  <include if="$(arg with_planner)" file="$(find uav_vln_bringup)/launch/planner_verified.launch">
    <arg name="speed_limit" value="$(arg speed_limit)"/>
    <arg name="accel_limit" value="$(arg accel_limit)"/>
    <arg name="obstacle_inflation" value="$(arg obstacle_inflation)"/>
    <arg name="refinement_fitness" value="$(arg refinement_fitness)"/>
  </include>
  <node pkg="uav_vln_bringup" type="flight_executor.py" name="flight_executor" output="screen" required="true">
    <param name="mock_fcu" value="$(arg mock_fcu)"/>
    <param name="segment_fence" value="$(arg segment_fence)"/>
  </node>
</launch>
