+  const char *EGOReplanFSM::managedSpaceViolation(double start, bool check_occupied,
+                                                      const Eigen::Vector3d &anchor)
+  {
+    auto map = planner_manager_->grid_map_;
+    auto &trajectory = planner_manager_->local_data_;
+    Eigen::Vector3i start_voxel;
+    map->posToIndex(anchor, start_voxel);
+    const double anchor_tolerance = std::min(0.05, 0.5 * map->getResolution());
+    constexpr double time_step = 0.04;
+    const double first = std::floor(std::max(0.0, std::min(start, trajectory.duration_)) / time_step);
+    for (double index = first;; ++index)
+    {
+      const double sample = std::min(index * time_step, trajectory.duration_);
+      const Eigen::Vector3d point = trajectory.position_traj_.evaluateDeBoorT(sample);
+      if (!map->isInMap(point))
+        return "outside_known_map";
+      if (check_occupied && map->getInflateOccupancy(point) != 0)
+        return "occupied_trajectory";
+      // The depth camera cannot observe the volume currently occupied by
+      // the aircraft itself. Only this measured collision box (plus a half
+      // voxel for discretization), anchored once per trajectory, is exempt
+      // from UNKNOWN checks. Inflated OCCUPANCY is always checked above.
+      const Eigen::Vector3d body_delta =
+        (odom_orient_.conjugate() * (point-anchor)).cwiseAbs();
+      const bool in_start_body = start_body_half_size_.minCoeff() > 0.0 &&
+        (body_delta.array() <= (start_body_half_size_ +
+          Eigen::Vector3d::Constant(0.5 * map->getResolution())).array()).all();
+      Eigen::Vector3i planned_voxel;
+      map->posToIndex(point, planned_voxel);
+      if (planned_voxel != start_voxel &&
+          (point - anchor).norm() > anchor_tolerance && !in_start_body &&
+          map->isUnknown(planned_voxel))
+      {
+        ROS_WARN_THROTTLE(1.0, "Unknown planned sample at %.3f %.3f %.3f (current %.3f %.3f %.3f)",
+                          point.x(), point.y(), point.z(), odom_pos_.x(), odom_pos_.y(), odom_pos_.z());
+        return "unknown_trajectory";
+      }
+      if (sample == trajectory.duration_)
+        break;
+    }
+    return nullptr;
   }
 
